@model ListingEditViewModel
@{ ViewData["Title"] = "İlan Ver"; }

<div class="create-hero reveal-on-scroll">
    <div class="create-hero-content">
        <span class="hero-kicker">YENİ İLAN</span>
        <h1>Evinizi Platforma Taşıyın</h1>
        <p>Birkaç adımda ilanınızı yayına alın, binlerce potansiyel kiracıya ulaşın.</p>
    </div>
    <div class="create-steps-bar">
        <div class="create-step active">
            <span class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3h10a2 2 0 0 1 2 2v16l-7-3-7 3V5a2 2 0 0 1 2-2Z"/><path d="M9 8h6M9 12h6"/></svg>
            </span>
            <span>Temel Bilgiler</span>
        </div>
        <div class="step-divider"></div>
        <div class="create-step active">
            <span class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
            </span>
            <span>Özellikler</span>
        </div>
        <div class="step-divider"></div>
        <div class="create-step active">
            <span class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="10" r="1.5"/><path d="m21 16-5-5L5 19"/></svg>
            </span>
            <span>Fotoğraflar</span>
        </div>
        <div class="step-divider"></div>
        <div class="create-step active">
            <span class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>
            </span>
            <span>Yayınla</span>
        </div>
    </div>
</div>

<section class="create-shell reveal-on-scroll">
    <partial name="_ListingForm" model="Model" />
</section>
